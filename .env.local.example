# cp .env.local.example .env.local  — then fill in.  NEVER commit .env.local

# ── Medplum ──────────────────────────────────────────────────────────────────
# app.medplum.com → Admin → Client Applications → Create
MEDPLUM_BASE_URL=https://api.medplum.com/
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=

# ── Seeded resource IDs — printed by `npx tsx scripts/seed.ts` ───────────────
SEED_PATIENT_ID=
SEED_COVERAGE_ID=
SEED_CAREPLAN_ID=
SEED_MEDICATIONREQUEST_ID=
SEED_SERVICEREQUEST_ID=
SEED_SCHEDULE_ID=
SEED_SATURDAY_SLOT_ID=
SEED_DOC_IDS={}

# ── Moss ─────────────────────────────────────────────────────────────────────
# Smoke-test the SDK before wiring. Falls back to local retrieval if unset.
MOSS_API_KEY=
MOSS_INDEX_NAME=careplan-rules

# ── Stedi (test mode) ────────────────────────────────────────────────────────
# Find the TEST payer/member/NPI values in Stedi's docs — wrong IDs return
# valid-but-empty responses. Falls back to a canned 271 if unset.
STEDI_API_KEY=
STEDI_TEST_PAYER_ID=
STEDI_TEST_PAYER=Test Payer
STEDI_TEST_MEMBER_ID=TEST-MEMBER-001
STEDI_TEST_NPI=

# ── Person B's lane ──────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=
DEEPGRAM_PROJECT_ID=
ANTHROPIC_API_KEY=
